# Reproduction targets for "Safe to Omit, Worth Omitting?".
#
#   make setup     create .venv and install the pinned CPU environment
#   make figures   regenerate every figure in the paper (no download); fails on any difference
#   make data      download the released records from Hugging Face and check every file's hash
#   make verify    re-derive three published results from the per-question records
#   make reproduce figures + data + verify
#
# Nothing here loads a model or needs a GPU.

PYTHON  ?= python3
VENV    ?= .venv
RUN     := $(shell [ -x "$(VENV)/bin/python" ] && echo "$(VENV)/bin/python" || echo "$(PYTHON)")
HF      := $(shell [ -x "$(VENV)/bin/hf" ] && echo "$(VENV)/bin/hf" || echo hf)
DATASET ?= AgentsSci/ICLR2027-SafeToOmit
DATA    ?= data
# Fixed PDF timestamp and uncompressed PDF streams (code/figures/matplotlibrc), so the
# regenerated figures are byte-identical to the committed ones.
export SOURCE_DATE_EPOCH := 1793750400
export MATPLOTLIBRC := $(CURDIR)/code/figures/matplotlibrc
DIFF = $(if $(wildcard .git),git diff --exit-code --stat -- figures,@true)

.DEFAULT_GOAL := help
.PHONY: help setup figures data verify reproduce clean

help:
	@sed -n '3,9p' Makefile | sed 's/^# \{0,1\}//'

setup:
	$(PYTHON) -m venv $(VENV)
	$(VENV)/bin/python -m pip install --quiet --upgrade pip
	$(VENV)/bin/python -m pip install --quiet -r requirements.txt
	@echo "== setup: OK"

figures:
	$(RUN) code/figures/fig2_boundary.py > /dev/null
	@for s in code/figures/appendix/fig*.py; do $(RUN) $$s > /dev/null || exit 1; echo "  ok  $$s"; done
	$(DIFF)
	@echo "== figures: OK  (every figure regenerated byte for byte; each script also checks its plotted numbers)"

data:
	$(HF) download $(DATASET) --repo-type dataset --local-dir $(DATA)
	$(RUN) scripts/check_data.py $(DATA)

verify:
	PYTHON=$(RUN) bash verify/run_all.sh

reproduce: figures data verify

clean:
	find . -name __pycache__ -type d -prune -exec rm -rf {} +
